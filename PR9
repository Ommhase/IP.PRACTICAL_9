# Question 7: Recursive Function - Factorial
# ==========================================================
print("\n--- Question 7 ---")
def factorial(n):
    if n == 0 or n == 1:
        return 1
    return n * factorial(n - 1)

num = 5
print(f"Recursive Factorial of {num}: {factorial(num)}")

# Comparison with iterative loop
fact_loop = 1
for i in range(1, num + 1):
    fact_loop *= i
print(f"Loop-based Factorial of {num}: {fact_loop}")


# ==========================================================
# Question 8: Recursive Fibonacci Series
# ==========================================================
print("\n--- Question 8 ---")
def fibonacci(n):
    if n <= 1:
        return n
    return fibonacci(n - 1) + fibonacci(n - 2)

terms = 6
print(f"Fibonacci series ({terms} terms):")
for i in range(terms):
    print(fibonacci(i), end=" ")
print()


