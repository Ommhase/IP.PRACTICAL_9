# Question 11: Menu-Driven Program using Functions
# ==========================================================
print("\n--- Question 11 ---")
def addition():
    a = float(input("Enter first number: "))
    b = float(input("Enter second number: "))
    print(f"Sum = {a + b}")

def prime():
    n = int(input("Enter a number to check prime: "))
    if n <= 1:
        print(f"{n} is Not Prime")
        return
    for i in range(2, int(n ** 0.5) + 1):
        if n % i == 0:
            print(f"{n} is Not Prime")
            return
    print(f"{n} is Prime")

def calc_factorial():
    n = int(input("Enter number for factorial: "))
    fact = 1
    for i in range(1, n + 1):
        fact *= i
    print(f"Factorial = {fact}")

print("Menu:")
print("1. Addition")
print("2. Prime Check")
print("3. Factorial")

choice = int(input("Enter your choice (1-3): "))
if choice == 1:
    addition()
elif choice == 2:
    prime()
elif choice == 3:
    calc_factorial()
else:
    print("Invalid choice!")


# ==========================================================
# Question 12: Real-World Problem - Student Result System
# ==========================================================
print("\n--- Question 12 ---")
def input_marks():
    marks = []
    for i in range(5):
        m = float(input(f"Enter marks for subject {i + 1}: "))
        marks.append(m)
    return marks

def calculate_results(marks):
    total = sum(marks)
    percentage = total / len(marks)
    return total, percentage

def get_grade(percentage):
    if percentage >= 90:
        return "A"
    elif percentage >= 75:
        return "B"
    elif percentage >= 50:
        return "C"
    else:
        return "Fail"

def student_result_system():
    marks = input_marks()
    total, percentage = calculate_results(marks)
    grade = get_grade(percentage)

    print("\n--- Final Student Report ---")
    print(f"Total Marks : {total}")
    print(f"Percentage  : {percentage:.2f}%")
    print(f"Grade       : {grade}")

student_result_system()
